# Netquor web: copy to .env (or pass as container environment) and fill in. Nothing here is committed. `bun server/scripts/env-check.ts` says what is missing or wrong.
# The same image runs twice: 'web' (SvelteKit pages + the API) and 'worker' (price poll). Both read these settings; the worker needs the PRICING_* ones and WEB_INTERNAL_URL.

# --- Web process (SvelteKit adapter) ---
# PORT / HOST are read by the adapter in the container (3000 / 0.0.0.0). The container publishes no port: only the edge proxy reaches it.
PORT=3000
HOST=0.0.0.0
# The adapter takes the client address from this header. The edge Caddy must OVERWRITE it from its trusted Cloudflare client_ip.
ADDRESS_HEADER=X-Real-IP

# The public origin (canonical host): used in /sitemap.xml and absolute links.
SITE_ORIGIN=https://www.netquor.com
# Where the worker reaches the web process on the private network.
WEB_INTERNAL_URL=http://netquor-web:3000

# --- Lead form (POST /api/lead) ---
# Browser origins allowed to post the form (comma separated, no paths, no trailing slash).
ALLOWED_ORIGINS=https://www.netquor.com,https://netquor.com
# Per-address limit: this many requests in this many seconds (sliding window, in memory, one web process).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
# Where a lead goes. File: one JSON object per line, mode 0600, on the 'data' volume (default /app/data/leads.jsonl in the container,
# server/data/leads.jsonl in dev). On by default unless LEAD_FORWARD_URL is set and LEAD_FILE is not.
LEAD_FILE=
# Webhook to the Netquor API (https://api.netquor.com/v1/leads/site). Signed with X-Netquor-Signature using LEAD_FORWARD_SECRET, which must equal the API's
# LEADS_WEBHOOK_SECRET (openssl rand -hex 32). Both set: delivered to both, accepted if either works.
LEAD_FORWARD_URL=
LEAD_FORWARD_SECRET=

# --- Prices ---
# The Netquor API signs a snapshot it POSTs to /hooks/pricing with this secret (openssl rand -hex 32). This is the PRIMARY update path.
PRICING_WEBHOOK_SECRET=
# During a rotation, the new secret; either one verifies. Remove the old one afterwards.
PRICING_WEBHOOK_SECRET_NEXT=
# The worker (backup path) polls this address, and the web process pulls from it when the API nudges it. https, or http for localhost only. Empty: no poll.
PRICING_API_URL=
# Sent as "Authorization: Bearer" on the poll, if the API wants one.
PRICING_API_TOKEN=
# Seconds between polls, 60 or more (default 900; 300 in catalog mode).
PRICING_POLL_SECONDS=900

# --- Catalog mode (live prices from the Netquor API price catalog; public reads, no token) ---
# When set, the worker polls the catalog instead of PRICING_API_URL (catalog wins if both are set), and a price.changed webhook makes the web process pull from it too.
# Both the web and the worker containers need these. https only (http to localhost for tests).
NETQUOR_CATALOG_URL=
# Comma separated product ids to read (default netquor-fleet,netquor-phone). Only products used in server/data/catalog-map.json matter.
NETQUOR_CATALOG_PRODUCTS=netquor-fleet,netquor-phone
# The map of catalog-managed price keys (default data/catalog-map.json). Keys not in it (vpn.*, network.*, homeassistant.*, digitalaccess.*) stay manual.
# CATALOG_MAP_FILE=data/catalog-map.json
# Default folder for prices.json, baseline.json and leads.jsonl (the 'data' volume; the compose file sets /data). Only the web process writes here.
# PRICES_DIR and LEAD_FILE, when set, override it for their own files.
DATA_DIR=data
PRICES_DIR=
