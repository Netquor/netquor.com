{
  "name": "netquor-web",
  "version": "0.1.0",
  "private": true,
  "description": "The small server behind netquor.com: takes lead forms from the static site, and (with the worker) keeps the prices stamped into its pages up to date.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "env:check": "bun scripts/env-check.ts",
    "send-prices": "bun scripts/send-prices.ts"
  },
  "dependencies": {
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
