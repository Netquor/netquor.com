# The web process. The adapter reads PORT, HOST, ORIGIN, ADDRESS_HEADER and BODY_SIZE_LIMIT; the API reads the rest (see ../server/.env.example).
PORT=3000
HOST=0.0.0.0
# The public origin as visitors see it. SvelteKit refuses (403) form-encoded or content-type-less POSTs whose Origin is missing or differs, so it must be exactly this. JSON posts are not affected.
ORIGIN=https://www.netquor.com
# The header the edge proxy overwrites with the trusted client address (the container publishes no ports).
ADDRESS_HEADER=X-Real-IP
SITE_ORIGIN=https://www.netquor.com
# Where the hand-written pages live: /app/legacy in the image, the repository root in development.
# LEGACY_DIR=/app/legacy
