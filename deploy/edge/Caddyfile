{
	email ops@netquor.com

	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips-v4 and /ips-v6), fetched 2026-11-10.
		# Refresh them from those two URLs when Cloudflare changes them. Only a request whose TCP peer is in this list
		# may name the visitor with CF-Connecting-IP; for anyone else {client_ip} is the peer's own address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# No apex (netquor.com) block on purpose: Cloudflare redirects the apex to www before it reaches this host, so
# the origin never serves or redirects the bare domain.

# The web container (SvelteKit pages + API). It publishes no port: only this proxy reaches it, over the web_front network.
# X-Real-IP is OVERWRITTEN here from the trusted client address; the web process reads the visitor from that header.
www.netquor.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	# Operational detail (price versions, sink status) is for the host only; reach it with: bun run deploy --status
	@internal path /health/detail /health/detail/*
	respond @internal 404

	reverse_proxy netquor-web:3000 {
		header_up X-Real-IP {client_ip}
	}

	# If the web container is down or unreachable, visitors get the static holding page (mounted at /srv/holding)
	# with a 503 and Retry-After instead of a bare error.
	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		header Retry-After "120"
		header Cache-Control "no-store"
		respond "{file./srv/holding/index.html}" 503
	}
}

phone.netquor.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy netquor-phone-site:80
}
